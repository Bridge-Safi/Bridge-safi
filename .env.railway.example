# ══════════════════════════════════════════════════════════════════
#  Bridge Safi — Variables d'environnement pour Railway
#  Copie ce fichier, remplis les valeurs, et colle-les dans
#  Railway → Settings → Variables
# ══════════════════════════════════════════════════════════════════

# ── Base de données (Railway PostgreSQL — fournie automatiquement) ─
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Clerk Auth ────────────────────────────────────────────────────
# https://dashboard.clerk.com → ton app → API Keys
CLERK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Session ───────────────────────────────────────────────────────
SESSION_SECRET=change_moi_en_une_chaine_aleatoire_longue

# ── Twilio (notifications WhatsApp + appels restaurants) ─────────
# https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+12025551234

# ── Google Maps (optionnel) ───────────────────────────────────────
VITE_GOOGLE_MAPS_KEY=

# ── Railway injecte PORT automatiquement — ne pas toucher ─────────
# PORT=3000
